# Runtime environment: set to "production" for deployed beta/production servers.
NODE_ENV="production"

# HTTP & WebSocket listen port (most hosts inject PORT automatically; defaults to 3000).
PORT="3000"

# Reverse-proxy hop count for accurate client IP detection behind a load balancer / proxy.
# Defaults to "1" when NODE_ENV=production and "false" in local development.
# Use "1" for single-proxy hosts (Render, Railway, Fly.io, Cloud Run, Nginx) or "2" behind CDN + proxy.
TRUST_PROXY="1"

# Note: Last Donkey (Rang Vapas) uses in-memory multiplayer rooms for beta and requires
# NO external API keys, NO OAuth secrets, and NO database connection strings.
